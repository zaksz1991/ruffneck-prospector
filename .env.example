# ========== REQUIRED (all free) ==========
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=your-service-role-key

# Groq free tier (no credit card) – https://console.groq.com
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# Redis (local free or Upstash free tier)
REDIS_URL=redis://localhost:6379/0

# ========== OPTIONAL FREE KEYS ==========
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=RuffNeckProspector/1.0 by u/yourusername

YOUTUBE_API_KEY=

# Google Custom Search (100 free queries/day) – optional, DuckDuckGo works without it
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# Free email via Gmail App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youremail@gmail.com
SMTP_PASS=your-16-char-app-password
FROM_NAME=RuffNeck Services
FROM_EMAIL=youremail@gmail.com

# Optional free email enrichment (waterfall)
# Hunter.io free tier: https://hunter.io
HUNTER_API_KEY=
# Apollo.io free tier: https://apollo.io
APOLLO_API_KEY=

# Optional: LinkedIn cookies JSON for deeper profile access (export from browser)
# LINKEDIN_COOKIES_FILE=/path/to/linkedin_cookies.json

